{
    "name": "oktopost/pofig",
    "description": "Messaging library",
    "type": "lib",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexey Puchkov",
            "email": "alexey@oktopost.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "oktopost/skeleton": "^2.0",
        "oktopost/objection": "^2.0",
        "oktopost/annotation": "^1.0",
        "predis/predis": "^1.1",
        "oktopost/structura": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Pofig\\": "src/Pofig"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "./vendor/phpunit/phpunit/phpunit",
        "test-cover": "./vendor/phpunit/phpunit/phpunit --coverage-html ./build/cover"
    }
}
