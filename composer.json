{
    "name": "oktopost/pofig",
    "description": "Configuration library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexey Puchkov",
            "email": "alexey@oktopost.com"
        },
		{
			"name": "Roman Azarov",
			"email": "azarovroman@gmail.com"
		}
	],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.5",
        "oktopost/objection": "^2.0",
        "oktopost/structura": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Pofig\\": "src/Pofig"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "scripts": {
        "test": "./vendor/phpunit/phpunit/phpunit",
        "test-coverage": [
            "./vendor/phpunit/phpunit/phpunit --coverage-clover build/logs/clover.xml",
            "php scripts/check-coverage.php build/logs/clover.xml 100"
        ],
        "test-cover": "./vendor/phpunit/phpunit/phpunit --coverage-html ./build/cover"
    }
}
